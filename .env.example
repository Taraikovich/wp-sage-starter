COMPOSE_PROJECT_NAME=starter

# Тема Sage: каталог wp-content/themes/<THEME_SLUG>
THEME_SLUG=starter
THEME_NAME=Starter

WP_PORT=8080
VITE_PORT=5173
PMA_PORT=8081
MAILPIT_PORT=8025

WP_HOME=http://localhost:8080
WP_TITLE=Starter
WP_LOCALE=ru_RU

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Плагины с wordpress.org, ставятся при make install
WP_PLUGINS="codeideal-open-fields contact-form-7 webp-uploads"

DB_NAME=starter
DB_USER=starter
DB_PASSWORD=starter
DB_ROOT_PASSWORD=starter
DB_HOST=db
